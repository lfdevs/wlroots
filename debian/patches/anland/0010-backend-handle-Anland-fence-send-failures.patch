From: lfdevs <lfdevs@lfdevs.com>
Date: Mon, 5 Oct 2026 04:27:50 +0800
Subject: backend: handle Anland fence send failures

Retry interrupted fence messages and enter fallback when the consumer socket rejects a render-complete notification, preventing the output loop from continuing with a dead transport.
---
 backend/anland/display_producer.c | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/backend/anland/display_producer.c b/backend/anland/display_producer.c
index 081eafe..3fcecbf 100644
--- a/backend/anland/display_producer.c
+++ b/backend/anland/display_producer.c
@@ -304,11 +304,18 @@ int trigger_refresh(display_ctx *ctx)
         c->cmsg_len = CMSG_LEN(sizeof(int));
         memcpy(CMSG_DATA(c), &ctx->pending_render_fence, sizeof(int));
     }
-    sendmsg(ctx->fence_fd, &msg, MSG_NOSIGNAL | MSG_DONTWAIT);
+    ssize_t n;
+    do {
+        n = sendmsg(ctx->fence_fd, &msg, MSG_NOSIGNAL | MSG_DONTWAIT);
+    } while (n < 0 && errno == EINTR);
     if (ctx->pending_render_fence >= 0) {
         close(ctx->pending_render_fence);
         ctx->pending_render_fence = -1;
     }
+    if (n != 1) {
+        enter_fallback(ctx);
+        return -1;
+    }
     return 0;
 }
 
